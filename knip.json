{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.tsx",
    "src/**/*.test.{ts,tsx}",
    "src/**/__audit__/**/*.{ts,tsx}",
    "e2e/**/*.ts",
    "scripts/**/*.{ts,mjs,js}",
    "supabase/functions/**/index.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright*.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts", "supabase/functions/**/*.ts"],
  "ignoreExportsUsedInFile": true
}
