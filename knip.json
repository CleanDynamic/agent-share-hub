{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/**/*.test.{ts,tsx}",
    "src/**/__audit__/**/*.{ts,tsx}",
    "e2e/**/*.ts",
    "scripts/**/*.{ts,mjs,js}",
    "supabase/functions/**/index.ts",
    "playwright*.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "e2e/**/*.ts",
    "supabase/functions/**/*.ts"
  ],
  "ignoreExportsUsedInFile": true,
  "ignore": [
    "src/pages/dev/VisionNotBuilt.tsx",
    "supabase/functions/**/*.test.ts"
  ]
}
