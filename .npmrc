# npm 7+ enforces peer ranges that two of this project's dependencies have not
# caught up with:
#
#   lovable-tagger@1.1.13  declares vite ">=5.0.0 <8.0.0", the project is on vite 8
#   next-themes@0.3.0      declares react "^16.8 || ^17 || ^18", the project is on react 19
#
# Neither is a real incompatibility — the tagger only loads in development mode
# and next-themes works under React 19 — but the strict check aborts both
# `npm install` and `npm ci`, so nothing installs and the Netlify build (which
# runs `npm run build`) never reaches vite. package-lock.json was resolved under
# the legacy rules and is internally consistent; this pins that resolution so a
# clean checkout installs the same tree.
legacy-peer-deps=true
