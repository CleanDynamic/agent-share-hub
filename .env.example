# NeoScale AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to GitHub — it is already in .gitignore.
# Stripe secret key goes in Supabase Edge Function secrets, not here.

# Supabase
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Stripe (publishable key only — safe for frontend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key

# Site URL (used for canonical tags and sitemap)
VITE_SITE_URL=https://neoscaleai.com

# Supabase Edge Function secrets — set these in Supabase dashboard, NOT here:
# STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
