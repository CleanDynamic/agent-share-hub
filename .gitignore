# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.next
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript incremental build artefacts
*.tsbuildinfo

# Playwright run output
test-results
playwright-report

# Verification scaffolding: throwaway scripts a session writes beside the repo
# (a Playwright config override, a colour-audit probe). Never part of a build.
*.tmp.mjs
*.tmp.ts

# Audit sweep reports (BG-P30). Regenerated by `npm run audit`; the CSVs are a
# run's findings, not source, and a committed copy goes stale the next repaint.
e2e/audit/out

# Deno lockfile for supabase/functions/. Generated locally by `deno test` and
# `deno check`, in whatever lockfile format the local Deno happens to write;
# Lovable deploys these functions to an edge runtime on its own Deno version,
# so a committed lockfile is a format mismatch waiting to happen. The import
# map in each function's deno.json is the pin that travels.
supabase/functions/**/deno.lock
